---
// Drapeaux simplifiés en SVG (les emojis drapeaux ne s'affichent pas sous Windows).
interface Props { code: string }
const { code } = Astro.props;
---
<svg class="flag" viewBox="0 0 30 20" width="30" height="20" aria-hidden="true">
  {code === "fr" && (<><rect width="10" height="20" fill="#002654"/><rect x="10" width="10" height="20" fill="#fff"/><rect x="20" width="10" height="20" fill="#CE1126"/></>)}
  {code === "de" && (<><rect width="30" height="7" fill="#000"/><rect y="6.67" width="30" height="6.67" fill="#DD0000"/><rect y="13.33" width="30" height="6.67" fill="#FFCE00"/></>)}
  {code === "es" && (<><rect width="30" height="20" fill="#AA151B"/><rect y="5" width="30" height="10" fill="#F1BF00"/></>)}
  {code === "pt" && (<><rect width="30" height="20" fill="#FF0000"/><rect width="12" height="20" fill="#006600"/><circle cx="12" cy="10" r="4" fill="#FFCC00"/><circle cx="12" cy="10" r="2.6" fill="#FF0000"/><circle cx="12" cy="10" r="1.7" fill="#fff"/></>)}
  {code === "tr" && (<><rect width="30" height="20" fill="#E30A17"/><circle cx="11" cy="10" r="5" fill="#fff"/><circle cx="12.3" cy="10" r="4" fill="#E30A17"/><path d="M17 10l4.3-1.4-2.7 3.7v-4.6l2.7 3.7z" fill="#fff"/></>)}
  {code === "en" && (<><rect width="30" height="20" fill="#012169"/><path d="M0 0l30 20M30 0L0 20" stroke="#fff" stroke-width="4"/><path d="M0 0l30 20M30 0L0 20" stroke="#C8102E" stroke-width="1.6"/><path d="M15 0v20M0 10h30" stroke="#fff" stroke-width="6"/><path d="M15 0v20M0 10h30" stroke="#C8102E" stroke-width="3.4"/></>)}
</svg>
