---
import { content, routes, type Lang } from "../i18n";
import Wave from "../components/Wave.astro";
import QuoteForm from "../components/QuoteForm.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const q = content[lang].pages.quote;
---
<section class="page-hero page-hero-short" style="--bg:url(/images/hero-devis.jpg)">
  <div class="container">
    <h1>{q.h1}</h1>
    <p class="lead">{q.sub}</p>
  </div>
  <Wave bars={22} class="page-hero-wave" />
</section>

<section class="section">
  <div class="container quote-grid">
    <div class="form-card">
      <p class="intro">{q.intro}</p>
      <QuoteForm lang={lang} kind="devis" />
    </div>
    <aside class="next">
      <h2 class="h3">{q.nextTitle}</h2>
      {q.next.map((p) => <p>{p}</p>)}
      <div class="recruit">
        <h2 class="h3">{q.recruitTitle}</h2>
        <p>{q.recruitText}</p>
        <p>{q.recruitSub}</p>
        <a class="btn btn-ghost" href={routes[lang].jobs}>{q.recruitBtn}</a>
      </div>
    </aside>
  </div>
</section>
