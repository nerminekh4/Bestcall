---
import { content, routes, linkify, type Lang } from "../i18n";
import Icon from "../components/Icon.astro";
import Wave from "../components/Wave.astro";
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = content[lang].pages.compare;
const r = routes[lang];
const ids = ["modeles", "tableau", "analyse", "decision", "questions", "faq"];
const L = (h: string) => linkify(h, lang);
---
<section class="compare-hero">
  <div class="container compare-hero-grid">
    <div>
      <p class="eyebrow eyebrow-light">{c.eyebrow}</p>
      <h1>{c.h1}</h1>
      <div class="summary"><p class="eyebrow eyebrow-light">{c.summaryLabel}</p><p>{c.summary}</p></div>
    </div>
    <Wave bars={20} class="compare-wave" />
  </div>
</section>

<div class="article">
  <nav class="toc container narrow" aria-label={c.tocTitle}>
    <p class="toc-title">{c.tocTitle}</p>
    <ol>{c.toc.map((t, i) => <li><a href={`#${ids[i]}`}>{t}</a></li>)}</ol>
  </nav>

  <section class="container narrow prose" id="modeles">
    {c.intro.map((p) => <p set:html={L(p)} />)}
    {c.models.map((m) => (<><h3>{m.title}</h3>{m.text.map((p) => <p set:html={L(p)} />)}</>))}
  </section>

  <section class="section section-paper" id="tableau">
    <div class="container">
      <div class="narrow-head"><p class="eyebrow">{c.tableEyebrow}</p><h2>{c.tableTitle}</h2></div>
      <div class="table-wrap">
        <table class="compare-table">
          <thead><tr>{c.tableHead.map((h) => <th scope="col">{h}</th>)}</tr></thead>
          <tbody>{c.rows.map((row) => <tr><th scope="row">{row[0]}</th><td>{row[1]}</td><td>{row[2]}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="analyse">
    <div class="container narrow prose">
      <p class="eyebrow">{c.analysisEyebrow}</p>
      <h2>{c.analysisTitle}</h2>
      {c.analysis.map((a) => (<>
        <h3>{a.title}</h3>
        {a.text.map((p) => <p set:html={L(p)} />)}
        {a.note && <p class="note">{a.note}</p>}
      </>))}
    </div>
    <div class="container narrow">
      <div class="inline-cta"><p>{c.midCta}</p><a class="btn btn-navy" href={r.quote}>{c.ctaBtn}</a></div>
    </div>
  </section>

  <section class="section section-paper" id="decision">
    <div class="container">
      <div class="narrow-head"><p class="eyebrow">{c.decisionEyebrow}</p><h2>{c.decisionTitle}</h2></div>
      <div class="decision-grid">
        <div class="decision-card"><h3>{c.tradTitle}</h3><ul class="dots">{c.trad.map((x) => <li>{x}</li>)}</ul></div>
        <div class="decision-card decision-card-accent"><h3>{c.nearTitle}</h3><ul class="checks">{c.near.map((x) => <li><Icon name="check" size={18} />{x}</li>)}</ul></div>
      </div>
      <div class="both narrow"><p class="h4">{c.bothTitle}</p><p>{c.both}</p></div>
    </div>
  </section>

  <section class="section" id="questions">
    <div class="container narrow prose">
      <p class="eyebrow">{c.methodEyebrow}</p>
      <h2>{c.methodTitle}</h2>
      <ol class="steps">{c.questions.map((q) => <li><strong>{q.q}</strong> {q.a}</li>)}</ol>
      <p>{c.methodOutro}</p>
      <div class="method"><p class="eyebrow">{c.methodologyEyebrow}</p><p set:html={L(c.methodology)} /></div>
    </div>
  </section>

  <section class="section section-paper" id="faq">
    <div class="container narrow prose">
      <p class="eyebrow">{c.faqEyebrow}</p>
      <h2>{c.faqTitle}</h2>
      <div class="faq">
        {c.faq.map((f) => <details><summary><span>{f.q}</span><Icon name="plus" size={20} class="faq-icon" /></summary><div class="faq-body"><p>{f.a}</p></div></details>)}
      </div>
    </div>
  </section>

  <section class="section section-navy">
    <div class="container cta-inner">
      <h2>{c.finalTitle}</h2>
      <a class="btn btn-gold btn-lg" href={r.quote}>{c.ctaBtn}</a>
    </div>
  </section>
</div>
