---
import "@fontsource/manrope/600.css";
import "@fontsource/manrope/700.css";
import "@fontsource/manrope/800.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/caveat/600.css";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { langs, langMeta, routes, type Lang, type PageKey } from "../i18n";
interface Props { lang: Lang; page: PageKey; title: string; description: string; ogImage?: string }
const { lang, page, title, description, ogImage = "/images/og-bestcall.jpg" } = Astro.props;
const site = Astro.site!;
const canonical = new URL(routes[lang][page], site).href;
---
<!doctype html>
<html lang={langMeta[lang].html}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={langMeta[l].html} href={new URL(routes[l][page], site).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(routes.fr[page], site).href} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="BestCall" />
    <meta property="og:locale" content={langMeta[lang].og} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#1B2C54" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <Header lang={lang} page={page} />
    <main id="contenu"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
